# Copy this file to .env and fill in the values. Never commit .env.

# The address the app runs at. Locally: http://localhost:5000
# On Render: your Render URL, e.g. https://photosortengine.onrender.com
APP_URL=http://localhost:5000

# Any long random string. Keeps sign-ins secure.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Drive sign-in (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OneDrive sign-in (Azure portal > Microsoft Entra ID > App registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows both personal (outlook.com/hotmail) and work/school accounts
MICROSOFT_TENANT=common
